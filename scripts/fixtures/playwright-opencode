#!/bin/sh
set -eu

if [ "${1:-}" = "--version" ]; then
  printf '%s\n' "opencode smoke 1.0"
  exit 0
fi

# A browser test can play the member this process serves: it reads the MCP
# servers the runtime handed to the session (the same credentials a real agent
# receives) and the prompts that reached it, from this directory (ADR 0225).
# It also records the permissions the process was launched with (ADR 0226).
dump="${KUBECODE_PLAYWRIGHT_FIXTURE_DIR:-}"
[ -z "$dump" ] || mkdir -p "$dump"
asked=0

while IFS= read -r line; do
  id=$(printf '%s' "$line" | sed -n 's/.*"id":"\([^"]*\)".*/"\1"/p')
  case "$line" in
    *'"method":"initialize"'*)
      printf '%s\n' "{\"jsonrpc\":\"2.0\",\"id\":$id,\"result\":{\"protocolVersion\":1,\"agentCapabilities\":{\"mcpCapabilities\":{\"http\":true}},\"authMethods\":[]}}"
      ;;
    *'"method":"session/new"'*)
      [ -z "$dump" ] || printf '%s\n' "$line" > "$dump/session-$$.json"
      [ -z "$dump" ] || printf '%s' "${OPENCODE_PERMISSION:-}" > "$dump/permission-$$.txt"
      printf '%s\n' "{\"jsonrpc\":\"2.0\",\"id\":$id,\"result\":{\"sessionId\":\"playwright-session\",\"modes\":{\"currentModeId\":\"build\",\"availableModes\":[{\"id\":\"build\",\"name\":\"Build\",\"description\":\"Use tools to implement changes\"},{\"id\":\"plan\",\"name\":\"Plan\",\"description\":\"Plan before implementation\"}]},\"configOptions\":[{\"id\":\"model\",\"name\":\"Model\",\"type\":\"select\",\"currentValue\":\"model-1\",\"options\":[{\"value\":\"model-1\",\"name\":\"Model 1\"}]}]}}"
      ;;
    *'"method":"session/prompt"'*)
      [ -z "$dump" ] || printf '%s\n' "$line" >> "$dump/prompts-$$.jsonl"
      printf '%s\n' '{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"playwright-session","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"Smoke Agent is ready"}}}}'
      printf '%s\n' '{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"playwright-session","update":{"sessionUpdate":"usage_update","used":1234,"size":8000}}}'
      # Hold the run open so the UI's "running" session status is observable
      # even when the browser renders the chunk slowly (loaded CI runners can
      # take >2s from chunk emission to first paint).
      # A prompt routed from the Workspace conversation is answered at once; the
      # long hold exists for the UI test that watches a run in progress.
      case "$line" in
        # A prompt carrying the marker asks the researcher's permission to run
        # a command (ADR 0232) and waits for the answer, or for the turn to be
        # stopped, before it ends.
        *'[smoke:permission]'*)
          asked=$((asked + 1))
          ask="perm-$$-$asked"
          printf '%s\n' "{\"jsonrpc\":\"2.0\",\"id\":\"$ask\",\"method\":\"session/request_permission\",\"params\":{\"sessionId\":\"playwright-session\",\"toolCall\":{\"toolCallId\":\"call-$asked\",\"title\":\"Run pytest -q\",\"kind\":\"execute\",\"status\":\"pending\"},\"options\":[{\"optionId\":\"allow\",\"name\":\"Allow once\",\"kind\":\"allow_once\"},{\"optionId\":\"reject\",\"name\":\"Reject\",\"kind\":\"reject_once\"}]}}"
          while IFS= read -r reply; do
            case "$reply" in
              *"\"id\":\"$ask\""*) break ;;
            esac
          done
          ;;
        *'General conversation'*general_post*) ;;
        *'The researcher accepted the results of Task'*|*'The researcher sent Task'*) ;;
        *) sleep 20 ;;
      esac
      printf '%s\n' "{\"jsonrpc\":\"2.0\",\"id\":$id,\"result\":{\"stopReason\":\"end_turn\"}}"
      ;;
  esac
done
